        }
      ],
      "Outputs": [
        {
          "Id": "e0000004-0000-0000-0000-000000000000-o0",
          "Name": "corridor_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 0
        },
        {
          "Id": "e0000004-0000-0000-0000-000000000000-o1",
          "Name": "log",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        }
      ],
      "Replication": "Disabled",
      "Description": "Crea corredor vial. Usa rasante existente + assembly camino. NO genera rasante.",
      "Name": "PASO 4: Crear Corredor",
      "X": 520,
      "Y": 880,
      "Script": "import clr, sys\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Corridor\n\nalignment_id  = IN[0]\nprofile_name  = IN[1]\nassembly_name = IN[2]\nsello_id      = IN[3]\n# IN[4] = pv_id — forza orden de ejecucion\n\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n\ndef find_profile(ali_id, name):\n    with db.TransactionManager.StartTransaction() as tr:\n        ali = tr.GetObject(ali_id, OpenMode.ForRead)\n        found = None\n        names = []\n        for pid in ali.GetProfileIds():\n            p = tr.GetObject(pid, OpenMode.ForRead)\n            names.append(p.Name)\n            if p.Name.upper() == name.upper(): found = pid\n        tr.Commit()\n    return found, names\n\ndef find_assembly(name):\n    import unicodedata\n    def n(s):\n        return ''.join(c for c in unicodedata.normalize('NFD', unicode(s)) if unicodedata.category(c) != 'Mn').upper()\n    tgt = n(name)\n    with db.TransactionManager.StartTransaction() as tr:\n        for aid in cdoc.GetAssemblyIds():\n            a = tr.GetObject(aid, OpenMode.ForRead)\n            if n(a.Name) == tgt:\n                tr.Commit()\n                return aid\n        tr.Commit()\n    return None\n\ntry:\n    prof_id, avail = find_profile(alignment_id, profile_name)\n    if prof_id is None:\n        raise ValueError(u'Profile not found: ' + profile_name + u'. Available: ' + str(avail))\n    asm_id = find_assembly(assembly_name)\n    if asm_id is None:\n        raise ValueError(u'Assembly not found: ' + assembly_name)\n    cst = sty(cdoc.Styles.CorridorStyles, 'Standard', u'Estandar')\n    tsf = sello_id if sello_id else ObjectId.Null\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            cor_id = Corridor.Create(cdoc, 'CORREDOR-EJE', alignment_id, prof_id, asm_id, tsf, cst)\n            cor = tr.GetObject(cor_id, OpenMode.ForWrite)\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            try:\n                reg = cor.Baselines[0].BaselineRegions[0]\n                reg.StartStation = ali.StartingStation\n                reg.EndStation   = ali.EndingStation\n            except: pass\n            cor.Rebuild()\n            tr.Commit()\n    OUT = [cor_id, u'[OK] Corridor created. Assembly=' + assembly_name + ', Profile=' + profile_name]\nexcept Exception as ex:\n    OUT = [None, '[ERR P4] ' + str(ex)]\n"
    },
