    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000001-0000-0000-0000-000000000000",
      "Inputs": [
        {
          "Id": "e0000001-0000-0000-0000-000000000000-i0",
          "Name": "layer_name",
          "Description": "Capa de la polilinea",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000001-0000-0000-0000-000000000000-i1",
          "Name": "alignment_name",
          "Description": "Nombre del alineamiento",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e0000001-0000-0000-0000-000000000000-o0",
          "Name": "alignment_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 0
        },
        {
          "Id": "e0000001-0000-0000-0000-000000000000-o1",
          "Name": "log",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        }
      ],
      "Replication": "Disabled",
      "Description": "Alineamiento desde polilinea EJE DE CAMINO (lineas + arcos).",
      "Name": "PASO 1: Crear Alineamiento",
      "X": 520,
      "Y": 0,
      "Script": "# PASO 1: Crear alineamiento desde polilinea en capa \"EJE DE CAMINO\"\n# Motor: IronPython2 (REQUIERE el paquete \"DynamoIronPython2.7\" en C3D 2026)\nimport clr, math\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment\n\nlayer_name = IN[0]\nali_name   = IN[1]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef norm(s):\n    # Normaliza acentos: la capa \"EJE DE CAMINO\" puede variar segun idioma\n    import unicodedata\n    return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                   if unicodedata.category(c) != 'Mn').upper()\n\ndef bulge_arc(p1, p2, b):\n    # Convierte el bulge de la Lwpolyline a parametros de arco fijo\n    t  = 4.0 * math.atan(abs(b))\n    d  = math.sqrt((p2.X-p1.X)**2 + (p2.Y-p1.Y)**2)\n    if d < 1e-9:\n        return None\n    r  = d / (2.0 * math.sin(t / 2.0))\n    mx, my = (p1.X+p2.X)/2.0, (p1.Y+p2.Y)/2.0\n    dm = math.sqrt(max(0.0, r*r - (d/2.0)**2))\n    ca = math.atan2(p2.Y-p1.Y, p2.X-p1.X)\n    cw = b < 0\n    pp = ca + (math.pi/2.0 if not cw else -math.pi/2.0)\n    cx = mx + dm*math.cos(pp)\n    cy = my + dm*math.sin(pp)\n    return {'c': Point3d(cx, cy, 0.0), 'r': r,\n            'sa': math.atan2(p1.Y-cy, p1.X-cx),\n            'ea': math.atan2(p2.Y-cy, p2.X-cx), 'cw': cw}\n\ndef sty(col, *ns):\n    # Resuelve estilo tolerando idioma ES/EN; cae al primero disponible\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col:\n        return s\n    return ObjectId.Null\n\ntry:\n    tgt = norm(layer_name)\n    pid = None\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                # Solo Lwpolyline/Polyline2d/Polyline3d en la capa objetivo\n                if norm(obj.Layer) == tgt and isinstance(obj, (Polyline, Polyline2d, Polyline3d)):\n                    pid = oid\n                    break\n            tr.Commit()\n    if pid is None:\n        raise ValueError(u'No se encontro polilinea en la capa: ' + layer_name)\n\n    ast = sty(cdoc.Styles.AlignmentStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    lst = sty(cdoc.Styles.LabelSetStyles.AlignmentLabelSetStyles, 'Standard', u'Est\\xe1ndar', '_No Labels')\n    cl  = db.Clayer  # capa actual (ObjectId) por si CreateFromPolyline necesita capa valida\n\n    aid = None\n    log = ''\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            try:\n                # CreateFromPolyline preserva nativamente lineas y arcos.\n                # Firma: (CivilDoc, name, siteId, polylineId, layerName,\n                #         styleId, labelSetId, eraseExisting, addCurvesBetweenTangents)\n                # siteId = ObjectId.Null -> alineamiento sin sitio (C3D 2024+)\n                aid = Alignment.CreateFromPolyline(\n                    cdoc, ali_name, ObjectId.Null, pid,\n                    'C-ROAD-CNTR', ast, lst, False, True)\n                log = u'[OK] Alineamiento creado con CreateFromPolyline (arcos preservados).'\n                tr.Commit()\n            except Exception as e:\n                tr.Abort()\n                log = u'[WARN] CreateFromPolyline fallo (' + str(e) + u'). Fallback manual.'\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as t2:\n                        pl  = t2.GetObject(pid, OpenMode.ForRead)\n                        # Alignment.Create(CivilDoc, name, siteId, layer(str), styleId, labelSetId)\n                        aid = Alignment.Create(cdoc, ali_name, ObjectId.Null,\n                                               'C-ROAD-CNTR', ast, lst)\n                        al  = t2.GetObject(aid, OpenMode.ForWrite)\n                        ents = al.Entities\n                        nverts = pl.NumberOfVertices\n                        rng = range(nverts) if pl.Closed else range(nverts - 1)\n                        for i in rng:\n                            j  = (i + 1) % nverts\n                            p1 = pl.GetPoint3dAt(i)\n                            p2 = pl.GetPoint3dAt(j)\n                            bv = pl.GetBulgeAt(i)\n                            if abs(bv) < 1e-12:\n                                ents.AddFixedLine(Point3d(p1.X, p1.Y, 0.0),\n                                                  Point3d(p2.X, p2.Y, 0.0))\n                            else:\n                                av = bulge_arc(p1, p2, bv)\n                                if av:\n                                    ents.AddFixedArc(av['c'], av['r'],\n                                                     av['sa'], av['ea'], av['cw'])\n                        t2.Commit()\n                        log += u' Alineamiento manual creado OK.'\n    OUT = [aid, log]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P1] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000002-0000-0000-0000-000000000000",
      "Inputs": [
        {
          "Id": "e0000002-0000-0000-0000-000000000000-i0",
          "Name": "tn_name",
          "Description": "Superficie TN",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-i1",
          "Name": "sello_name",
          "Description": "Superficie SELLO",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-i2",
          "Name": "delta",
          "Description": "Delta en metros",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-i3",
          "Name": "alignment_id",
          "Description": "Dependencia PASO 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o0",
          "Name": "sello_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 0
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o1",
          "Name": "tn_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o2",
          "Name": "log",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 2
        }
      ],
      "Replication": "Disabled",
      "Description": "SELLO = TN - delta (vertices TIN con offset Z).",
      "Name": "PASO 2: Crear Superficie SELLO",
      "X": 520,
      "Y": 300,
      "Script": "# PASO 2: Crear superficie SELLO = TN - delta\n# CORRECCION EXPERTA: NO existen DefinitionAddPastedSurface ni\n# ElevationAdjustment. Se construye SELLO leyendo los vertices TIN de TN\n# (tn.Vertices -> TinSurfaceVertex.Location) y agregandolos a una TinSurface\n# nueva con Z desplazado -delta, mediante TinSurface.AddVertices (API real).\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name    = IN[0]\nsello_name = IN[1]\ndelta      = float(IN[2])\n# IN[3] = alignment_id (solo crea dependencia de orden con PASO 1)\n\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef find_surf(name):\n    for sid in cdoc.GetSurfaceIds():\n        with db.TransactionManager.StartTransaction() as tr:\n            s = tr.GetObject(sid, OpenMode.ForRead)\n            tr.Commit()\n            if s.Name.upper() == name.upper():\n                return sid\n    return None\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col:\n        return s\n    return ObjectId.Null\n\ntry:\n    if not (0.0 <= delta <= 0.60):\n        # No abortamos: solo advertimos (el rango pedido es 0.00-0.60 m)\n        pass\n    tn_id = find_surf(tn_name)\n    if tn_id is None:\n        raise ValueError(u'Superficie TN no encontrada: ' + tn_name)\n\n    # Si SELLO ya existe, se elimina para re-crear con el delta actual\n    ex_id = find_surf(sello_name)\n    if ex_id is not None:\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                tr.GetObject(ex_id, OpenMode.ForWrite).Erase()\n                tr.Commit()\n\n    st = sty(cdoc.Styles.SurfaceStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            tn  = tr.GetObject(tn_id, OpenMode.ForRead)\n            pts = Point3dCollection()\n            # tn.Vertices = TinSurfaceVertexCollection ; .Location = Point3d\n            for v in tn.Vertices:\n                loc = v.Location\n                pts.Add(Point3d(loc.X, loc.Y, loc.Z - delta))\n\n            sid = TinSurface.Create(cdoc, sello_name)\n            srf = tr.GetObject(sid, OpenMode.ForWrite)\n            if st != ObjectId.Null:\n                srf.StyleId = st\n            # AddVertices(Point3dCollection): metodo real de TinSurface\n            srf.AddVertices(pts)\n            srf.Rebuild()\n            tr.Commit()\n\n    OUT = [sid, tn_id,\n           u'[OK] SELLO creada (TN - %.3f m). Vertices: %d' % (delta, pts.Count)]\nexcept Exception as ex:\n    OUT = [None, None, u'[ERROR P2] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000003-0000-0000-0000-000000000000",
      "Inputs": [
        {
          "Id": "e0000003-0000-0000-0000-000000000000-i0",
          "Name": "alignment_id",
          "Description": "ObjectId alineamiento",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000003-0000-0000-0000-000000000000-i1",
          "Name": "tn_id",
          "Description": "ObjectId TN",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0000003-0000-0000-0000-000000000000-i2",
          "Name": "sello_id",
          "Description": "ObjectId SELLO",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e0000003-0000-0000-0000-000000000000-o0",
          "Name": "profile_view_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 0
        },
        {
          "Id": "e0000003-0000-0000-0000-000000000000-o1",
          "Name": "log",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        }
      ],
      "Replication": "Disabled",
      "Description": "Vista de perfil longitudinal con TN y SELLO, a la derecha del eje.",
      "Name": "PASO 3: Crear Vista de Perfil",
      "X": 520,
      "Y": 600,
      "Script": "# PASO 3: Vista de perfil longitudinal (perfiles de TN y SELLO)\n# CORRECCION EXPERTA: ProfileView.Create(aliId, point) -> luego se setean\n# Name/StyleId sobre el objeto abierto. Profile.CreateFromSurface usa la\n# firma (name, aliId, surfId, layerId, styleId, labelSetId).\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\nalignment_id = IN[0]\ntn_id        = IN[1]\nsello_id     = IN[2]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col:\n        return s\n    return ObjectId.Null\n\ndef make_surf_profile(tr, ali_id, surf_id, name, layer_oid):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        p = tr.GetObject(pid, OpenMode.ForRead)\n        try:\n            if p.ProfileType.ToString().find('Surface') >= 0 and p.Name == name:\n                return pid\n        except:\n            pass\n    ps = sty(cdoc.Styles.ProfileStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    ls = sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles, '_No Labels', 'Standard')\n    # Profile.CreateFromSurface(name, alignmentId, surfaceId, layerId, styleId, labelSetId)\n    return Profile.CreateFromSurface(name, ali_id, surf_id, layer_oid, ps, ls)\n\ntry:\n    pvs = sty(cdoc.Styles.ProfileViewStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            ext = ali.GeometricExtents\n            # Vista a la DERECHA del alineamiento (+150 m en X)\n            ins = Point3d(ext.MaxPoint.X + 150.0, ext.MinPoint.Y, 0.0)\n            cl  = db.Clayer\n\n            make_surf_profile(tr, alignment_id, tn_id,    u'PERF-TN',    cl)\n            make_surf_profile(tr, alignment_id, sello_id, u'PERF-SELLO', cl)\n\n            # ProfileView.Create(alignmentId, insertionPoint) -> ObjectId\n            pv_id = ProfileView.Create(alignment_id, ins)\n            pv = tr.GetObject(pv_id, OpenMode.ForWrite)\n            pv.Name = u'PV-EJE'\n            if pvs != ObjectId.Null:\n                pv.StyleId = pvs\n            tr.Commit()\n    OUT = [pv_id, u'[OK] Vista de perfil PV-EJE creada con TN y SELLO.']\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P3] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000004-0000-0000-0000-000000000000",
      "Inputs": [
