    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Id": "23d4e38e-11f2-4f7a-82b2-1b30b16080e3",
      "Name": "PASO 8: Plano Final",
      "Code": "# PASO 8: Generación del Plano Final\n# IN[0] platforms         IN[1] alignment_ids    IN[2] profile_name\n# IN[3] surface_name      IN[4] road_half_width  IN[5] cross_slope_road_pct\n# IN[6] cross_slope_plt_pct   IN[7] section_spacing\n# IN[8] create_layout     IN[9] plan_scale       IN[10] layout_name\n# IN[11] exaggeration_v   IN[12] table_y         IN[13] sections_y\n# OUT = logs\nimport clr, sys, os\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\n\n_dir = os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else ''\nfor _p in [_dir, os.path.join(_dir,'..'), r'C:\\Civil3D', r'C:\\Users\\Public\\Civil3D']:\n    if _p and _p not in sys.path: sys.path.insert(0, _p)\n\ntry:\n    from plano import generate_full_plan\n    from platforms import resolve_surface_id, resolve_profile_id, list_profile_names\nexcept ImportError as ie:\n    OUT = [\"ERROR: plano.py / platforms.py no encontrado: %s\" % ie]; raise SystemExit(0)\n\nlogs = []\nplatforms     = IN[0]  if isinstance(IN[0], list) else [IN[0]]\nalignment_ids = IN[1]  if isinstance(IN[1], list) else [IN[1]]\nprofile_name  = str(IN[2]).strip()\nsurface_name  = str(IN[3]).strip()\nroad_hw       = float(IN[4])  if IN[4]  is not None else 4.0\ncross_sl_road = float(IN[5])  if IN[5]  is not None else 2.5\ncross_sl_plt  = float(IN[6])  if IN[6]  is not None else 2.5\nspacing       = float(IN[7])  if IN[7]  is not None else 5.0\nmake_layout   = bool(IN[8])   if IN[8]  is not None else True\nplan_scale    = int(IN[9])    if IN[9]  is not None else 500\nlay_name      = str(IN[10]).strip() if IN[10] is not None else \"PLATAFORMAS\"\nexag_v        = float(IN[11]) if IN[11] is not None else 2.0\ntable_y       = float(IN[12]) if IN[12] is not None else 200.0\nsections_y    = float(IN[13]) if IN[13] is not None else -200.0\n\ntry:\n    surface_id = resolve_surface_id(surface_name)\nexcept ValueError as ex:\n    OUT = [str(ex)]; raise SystemExit(0)\n\nali_id     = alignment_ids[0]\nprofile_id = resolve_profile_id(ali_id, profile_name)\nif profile_id is None:\n    OUT = [\"Rasante '%s' no encontrada. Disponibles: %s\"\n           % (profile_name, list_profile_names(ali_id))]\n    raise SystemExit(0)\n\ntry:\n    logs = generate_full_plan(\n        surface_id, ali_id, profile_id, platforms,\n        road_half_width      = road_hw,\n        cross_slope_road_pct = cross_sl_road,\n        cross_slope_plt_pct  = cross_sl_plt,\n        spacing              = spacing,\n        create_layout        = make_layout,\n        plan_scale           = plan_scale,\n        layout_name          = lay_name,\n        table_y              = table_y,\n        sections_y           = sections_y,\n        section_exag_v       = exag_v,\n    )\nexcept Exception as ex:\n    import traceback\n    logs = [\"ERROR en generate_full_plan: %s\" % ex,\n            traceback.format_exc()]\n\nOUT = logs\n",
      "Engine": "IronPython2",
