        }
      ],
      "Replication": "Disabled",
      "Description": "Perfil con TN y SELLO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "706a5ba3-a391-4400-9c40-836fc13a185b",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 4: corredor por cada alineamiento usando PERF-TN como perfil base\n# API correcta: cdoc.CorridorCollection.Add(...) NO Corridor.Create()\n#               cdoc.AssemblyCollection para buscar el assembly\n# OUT = [ [corridor_id,...], logs ]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\n\np1=IN[0]; profile_name=IN[1]; assembly_name=IN[2]; p2=IN[3]; p3=IN[4]\nlogs=list(p3[1]) if (p3 and len(p3)>1 and p3[1]) else []\ndoc=Application.DocumentManager.MdiActiveDocument\ndb=doc.Database\ncdoc=CivilApplication.ActiveDocument\n\ndef sty(col,*ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef norm(s):\n    import unicodedata\n    return ''.join(c for c in unicodedata.normalize('NFD',unicode(s)) if unicodedata.category(c)!='Mn').upper()\n\ndef find_assembly(name):\n    tgt=norm(name)\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            r=None; names=[]\n            for oid in cdoc.AssemblyCollection:\n                a=tr.GetObject(oid,OpenMode.ForRead)\n                names.append(a.Name)\n                if norm(a.Name)==tgt: r=oid; break\n            tr.Commit()\n    return r,names\n\ndef ali_data(aid):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            a=tr.GetObject(aid,OpenMode.ForRead)\n            nm=a.Name; s0=a.StartingStation; s1=a.EndingStation\n            pr=None; pnames=[]\n            tn_key=u'PERF-TN-'+nm\n            for pid in a.GetProfileIds():\n                pn=tr.GetObject(pid,OpenMode.ForRead).Name\n                pnames.append(pn)\n                if pn.upper()==tn_key.upper(): pr=pid\n            tr.Commit()\n    return nm,s0,s1,pr,pnames\n\ndef delete_corridor(name):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            for cid in cdoc.CorridorCollection:\n                c=tr.GetObject(cid,OpenMode.ForRead)\n                if c.Name.upper()==name.upper():\n                    c.UpgradeOpen(); c.Erase(); tr.Commit(); return\n            tr.Commit()\n\ndef make_corridor(corNm,blNm,aid,pr,regNm,asmId):\n    errs=[]\n    sigs=[\n        lambda: cdoc.CorridorCollection.Add(corNm,blNm,aid,pr,regNm,asmId),\n        lambda: cdoc.CorridorCollection.Add(corNm,blNm,aid,pr),\n        lambda: cdoc.CorridorCollection.Add(corNm),\n    ]\n    for f in sigs:\n        try:\n            with doc.LockDocument(): return f(),None\n        except Exception as e: errs.append(str(e))\n    return None,' | '.join(errs)\n\ntry:\n    aids=p1[0] if (p1 and p1[0]) else []\n    if not aids:\n        OUT=[[],logs+[u'[SKIP P4] PASO 1 sin alineamientos.']]\n    elif not p3 or not p3[0]:\n        OUT=[[],logs+[u'[SKIP P4] PASO 3 sin vistas de perfil.']]\n    else:\n        asm_id,asm_names=find_assembly(assembly_name)\n        if asm_id is None:\n            disp=', '.join(asm_names) if asm_names else u'(ninguno en el modelo)'\n            raise ValueError(u'Assembly \"'+assembly_name+u'\" no encontrado. Disponibles: '+disp)\n        cor_ids=[]\n        for aid in aids:\n            nm,s0,s1,pr,pnames=ali_data(aid)\n            if pr is None:\n                disp=', '.join(pnames) if pnames else u'(sin perfiles)'\n                logs.append(u'[WARN P4] '+nm+u': perfil PERF-TN-'+nm+u' no encontrado. Disponibles: '+disp)\n                continue\n            try: delete_corridor(u'COR-'+nm)\n            except: pass\n            cid,err=make_corridor(u'COR-'+nm,u'BL-'+nm,aid,pr,u'REG-1',asm_id)\n            if cid is None:\n                logs.append(u'[WARN P4] '+nm+u': CorridorCollection.Add fallo: '+err)\n                continue\n            try:\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as tr:\n                        tr.GetObject(cid,OpenMode.ForWrite).Rebuild()\n                        tr.Commit()\n            except Exception as re:\n                logs.append(u'[WARN P4] '+nm+u' Rebuild: '+str(re))\n            cor_ids.append(cid)\n            logs.append(u'[OK P4] Corredor COR-'+nm+u' creado.')\n        logs.append(u'[INFO P4] Corredores creados: '+str(len(cor_ids))+u' de '+str(len(aids)))\n        OUT=[cor_ids,logs]\nexcept Exception as ex:\n    OUT=[[],logs+[u'[ERROR P4] '+str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
