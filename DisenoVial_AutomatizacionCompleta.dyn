      "Description": "Perfil longitudinal con TN y SELLO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "c959306f-78d2-47d5-b4c3-2d2326516e86",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 4: Corredor (Create -> Baselines.Add -> BaselineRegions.Add -> Rebuild)\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Corridor\n\nalignment_id  = IN[0]\nprofile_name  = IN[1]\nassembly_name = IN[2]\nsello_id      = IN[3]\n# IN[4] = pv_id (dependencia de orden)\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef find_profile(ali_id, name):\n    with db.TransactionManager.StartTransaction() as tr:\n        ali = tr.GetObject(ali_id, OpenMode.ForRead)\n        found, names = None, []\n        for pid in ali.GetProfileIds():\n            p = tr.GetObject(pid, OpenMode.ForRead)\n            names.append(p.Name)\n            if p.Name.upper() == name.upper():\n                found = pid\n        tr.Commit()\n    return found, names\n\ndef find_assembly(name):\n    import unicodedata\n    def n(s):\n        return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                       if unicodedata.category(c) != 'Mn').upper()\n    tgt = n(name)\n    with db.TransactionManager.StartTransaction() as tr:\n        for aid in cdoc.GetAssemblyIds():\n            if n(tr.GetObject(aid, OpenMode.ForRead).Name) == tgt:\n                tr.Commit()\n                return aid\n        tr.Commit()\n    return None\n\ntry:\n    prof_id, avail = find_profile(alignment_id, profile_name)\n    if prof_id is None:\n        raise ValueError(u'Rasante no encontrada: ' + profile_name +\n                         u'. Disponibles: ' + str(avail))\n    asm_id = find_assembly(assembly_name)\n    if asm_id is None:\n        raise ValueError(u'Assembly no encontrado: ' + assembly_name)\n    cst = sty(cdoc.Styles.CorridorStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            s0, s1 = ali.StartingStation, ali.EndingStation\n            cor_id = Corridor.Create(cdoc, u'CORREDOR-EJE')\n            cor = tr.GetObject(cor_id, OpenMode.ForWrite)\n            if cst != ObjectId.Null:\n                cor.StyleId = cst\n            bl  = cor.Baselines.Add(u'BL-EJE', alignment_id, prof_id)\n            reg = bl.BaselineRegions.Add(u'REG-1', asm_id)\n            try:\n                reg.StartStation = s0\n                reg.EndStation   = s1\n            except: pass\n            cor.Rebuild()\n            tr.Commit()\n    OUT = [cor_id, u'[OK] Corredor: assembly=' + assembly_name +\n           u', rasante=' + profile_name]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P4] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "9ed80c86-248a-46d5-aacf-a80a1ad2525d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ec45ad26-8d0c-423f-8a1c-0af72aba800a",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "801e2551-2cc5-4661-8be1-0fac5bdf7123",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
