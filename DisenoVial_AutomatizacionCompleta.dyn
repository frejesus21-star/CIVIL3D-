    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "aa4e4bec-ebaf-4e71-ad50-12259ecf6f7a",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 1: alineamiento NATIVO desde polilinea via PolylineOptions\n# (preserva arcos; metodo oficial Autodesk). Firma:\n# Alignment.Create(doc, PolylineOptions, name, siteName, layerName, styleName, labelSetName)\n# nombres como STRING; siteName=None -> sin sitio.\n# OUT = [ [alignment_id, ...], [log...] ]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment, PolylineOptions\n\nlayer_name = IN[0]\nali_base   = IN[1]\nDEST_LAYER = 'C-ROAD-CNTR'\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\nlogs = []\n\ndef ensure_layer(name):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n            if not lt.Has(name):\n                lt.UpgradeOpen()\n                ltr = LayerTableRecord(); ltr.Name = name\n                lt.Add(ltr); tr.AddNewlyCreatedDBObject(ltr, True)\n            tr.Commit()\n\ndef find_alignment(name):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            for aid in cdoc.GetAlignmentIds():\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                if a.Name.upper() == name.upper():\n                    tr.Commit(); return aid\n            tr.Commit()\n    return None\n\ndef delete_alignment(name):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            for aid in cdoc.GetAlignmentIds():\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                if a.Name.upper() == name.upper():\n                    a.UpgradeOpen(); a.Erase(); tr.Commit(); return\n            tr.Commit()\n\ndef length_of(oid):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            try: L = tr.GetObject(oid, OpenMode.ForRead).Length\n            except: L = 0.0\n            tr.Commit()\n    return L\n\n# pares (estiloAlineamiento, conjuntoEtiquetas) para EN/ES\nSTYLES = [('Standard', 'Standard'),\n          (u'Est\\xe1ndar', u'Est\\xe1ndar'),\n          ('Standard', '_No Labels'),\n          (u'Est\\xe1ndar', u'_Sin etiquetas'),\n          ('Standard', None)]\n\ndef create_native(pid, name):\n    errs = []\n    for sN, lN in STYLES:\n        try:\n            plops = PolylineOptions()\n            plops.AddCurvesBetweenTangents = False\n            plops.EraseExistingEntities = False\n            plops.PlineId = pid\n            with doc.LockDocument():\n                aid = Alignment.Create(cdoc, plops, name, None, DEST_LAYER, sN, lN)\n            return aid, None\n        except Exception as e:\n            errs.append((sN or 'None') + '/' + (lN or 'None') + ':' + str(e))\n    return None, ' | '.join(errs)\n\ntry:\n    plines = []\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                o = tr.GetObject(oid, OpenMode.ForRead)\n                if isinstance(o, (Polyline, Polyline2d, Polyline3d)):\n                    plines.append(oid)\n            tr.Commit()\n\n    if not plines:\n        OUT = [[], [u'[ERROR P1] No hay ninguna polilinea en el modelo.']]\n    else:\n        logs.append(u'[INFO P1] Polilineas encontradas: ' + str(len(plines)))\n        ensure_layer(DEST_LAYER)\n        aids = []\n        one = len(plines) == 1\n        for k, pid in enumerate(plines):\n            name = ali_base if one else (ali_base + u'-%02d' % (k + 1))\n            Lp = length_of(pid)\n            existing = find_alignment(name)\n            if existing is not None:\n                aids.append(existing)\n                La = length_of(existing)\n                logs.append(u'[OK P1] %s conservado (L=%.3f).' % (name, La))\n                continue\n            aid, err = create_native(pid, name)\n            if aid is None:\n                logs.append(u'[WARN P1] ' + name + u': ' + err)\n                continue\n            aids.append(aid)\n            La = length_of(aid)\n            d  = abs(Lp - La)\n            est = u'OK' if (Lp > 0 and d <= max(0.05, Lp * 0.002)) else u'REVISAR'\n            logs.append(u'[OK P1] %s creado | L.poli=%.3f L.ali=%.3f dif=%.3f -> %s'\n                        % (name, Lp, La, d, est))\n        if not aids:\n            logs.append(u'[ERROR P1] Ninguna polilinea pudo convertirse en alineamiento.')\n        else:\n            logs.append(u'[INFO P1] Alineamientos creados: ' + str(len(aids)))\n        OUT = [aids, logs]\nexcept Exception as ex:\n    OUT = [[], logs + [u'[ERROR P1] Global: ' + str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1134656e-778c-4305-b598-77763fec3480",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3a4b6566-7b75-4628-a9ed-226b95b753e7",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "316f3e53-45ee-45ce-81e5-ee6a42929941",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Alineamiento desde polilinea"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "99ff3ad8-61e2-4439-bf6a-1dcc98e9d5d0",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 2: SELLO = TN - delta\n# TinSurface.Create espera (nombre, estiloId), NO el CivilDocument.\n# Create* fuera de transaccion abierta. Prueba varias firmas y reporta error real.\n# OUT = [sello_id, tn_id, logs]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name=IN[0]; sello_name=IN[1]; delta=float(IN[2]); p1=IN[3]\nlogs=list(p1[1]) if (p1 and len(p1)>1 and p1[1]) else []\ndoc=Application.DocumentManager.MdiActiveDocument\ndb=doc.Database\ncdoc=CivilApplication.ActiveDocument\n\ndef sty(col,*ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef find_surf(name):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            r=None\n            for sid in cdoc.GetSurfaceIds():\n                s=tr.GetObject(sid,OpenMode.ForRead)\n                if s.Name.upper()==name.upper(): r=sid; break\n            tr.Commit()\n    return r\n\ndef erase_surf(sid):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            tr.GetObject(sid,OpenMode.ForWrite).Erase(); tr.Commit()\n\ndef read_verts(sid,dz):\n    pts=Point3dCollection()\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            s=tr.GetObject(sid,OpenMode.ForRead)\n            for v in s.Vertices:\n                L=v.Location\n                pts.Add(Point3d(L.X,L.Y,L.Z-dz))\n            tr.Commit()\n    return pts\n\ndef create_surf(name,styleId):\n    errs=[]\n    sigs=[\n        lambda: TinSurface.Create(name,styleId),\n        lambda: TinSurface.Create(db,name),\n    ]\n    for f in sigs:\n        try:\n            with doc.LockDocument(): return f(),None\n        except Exception as e: errs.append(str(e))\n    return None,' | '.join(errs)\n\ntry:\n    if not p1 or not p1[0]:\n        OUT=[None,None,logs+[u'[SKIP P2] PASO 1 sin alineamiento.']]\n    else:\n        tn_id=find_surf(tn_name)\n        if tn_id is None:\n            raise ValueError(u'Superficie TN no encontrada: '+tn_name)\n        ex=find_surf(sello_name)\n        if ex is not None: erase_surf(ex)\n        st=sty(cdoc.Styles.SurfaceStyles,'Standard',u'Est\\xe1ndar','Estandar')\n        pts=read_verts(tn_id,delta)\n        sid,err=create_surf(sello_name,st)\n        if sid is None:\n            raise ValueError(u'TinSurface.Create fallo: '+err)\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                srf=tr.GetObject(sid,OpenMode.ForWrite)\n                if st!=ObjectId.Null:\n                    try: srf.StyleId=st\n                    except: pass\n                srf.AddVertices(pts)\n                srf.Rebuild()\n                tr.Commit()\n        logs.append(u'[OK P2] SELLO = TN - %.3f m (%d vert.)'%(delta,pts.Count))\n        OUT=[sid,tn_id,logs]\nexcept Exception as ex:\n    OUT=[None,None,logs+[u'[ERROR P2] '+str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1e107ec8-2dfd-4069-849c-5e7aa7ec06e5",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "79443d39-8aa8-415d-9693-6ba2fec66dd2",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d1d2973d-d1ee-491e-8cb9-3c77d1c90e07",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "56ca0abe-ed47-4330-a7a2-8612e5dc9ee8",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1a88c82c-3f40-41bd-84d8-e1f9f6b0a0a2",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "SELLO = TN - delta"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "93d37704-1856-4d56-867b-32fcf1bbab16",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 3: una vista de perfil (TN + SELLO) por CADA alineamiento\n# Create* fuera de transaccion abierta; prueba varias firmas; reporta error real.\n# OUT = [ [pv_id,...], logs ]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\np1=IN[0]; p2=IN[1]\nlogs=list(p2[2]) if (p2 and len(p2)>2 and p2[2]) else []\ndoc=Application.DocumentManager.MdiActiveDocument\ndb=doc.Database\ncdoc=CivilApplication.ActiveDocument\n\ndef sty(col,*ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef ali_info(aid):\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            a=tr.GetObject(aid,OpenMode.ForRead)\n            nm=a.Name\n            ext=a.GeometricExtents\n            mnx,mny=ext.MinPoint.X,ext.MinPoint.Y\n            mxx,mxy=ext.MaxPoint.X,ext.MaxPoint.Y\n            existing=[tr.GetObject(pid,OpenMode.ForRead).Name for pid in a.GetProfileIds()]\n            tr.Commit()\n    return nm,mnx,mny,mxx,mxy,existing\n\ndef make_profile(name,aid,sid,lay):\n    ps=sty(cdoc.Styles.ProfileStyles,'Standard',u'Est\\xe1ndar','Estandar')\n    ls=sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles,'_No Labels','Standard')\n    errs=[]\n    sigs=[\n        lambda: Profile.CreateFromSurface(name,aid,sid,lay,ps,ls),\n        lambda: Profile.CreateFromSurface(cdoc,name,aid,sid,lay,ps,ls),\n    ]\n    for f in sigs:\n        try:\n            with doc.LockDocument(): return f(),None\n        except Exception as e: errs.append(str(e))\n    return None,' | '.join(errs)\n\ndef make_pv(name,aid,x,y,pvs):\n    pt=Point3d(x,y,0.0)\n    errs=[]\n    sigs=[\n        lambda: ProfileView.Create(aid,pt),\n        lambda: ProfileView.Create(cdoc,aid,pt),\n        lambda: ProfileView.Create(name,aid,pt,pvs),\n    ]\n    for f in sigs:\n        try:\n            with doc.LockDocument(): return f(),None\n        except Exception as e: errs.append(str(e))\n    return None,' | '.join(errs)\n\ntry:\n    aids=p1[0] if (p1 and p1[0]) else []\n    if not aids:\n        OUT=[[],logs+[u'[SKIP P3] PASO 1 sin alineamientos.']]\n    elif not p2 or p2[0] is None:\n        OUT=[[],logs+[u'[SKIP P3] PASO 2 sin SELLO.']]\n    else:\n        sello_id=p2[0]; tn_id=p2[1]\n        pvs=sty(cdoc.Styles.ProfileViewStyles,'Standard',u'Est\\xe1ndar','Estandar')\n        cl=db.Clayer\n        pv_ids=[]\n        for k,aid in enumerate(aids):\n            try:\n                nm,mnx,mny,mxx,mxy,existing=ali_info(aid)\n                nTN=u'PERF-TN-'+nm; nSE=u'PERF-SELLO-'+nm\n                if nTN not in existing:\n                    r,e=make_profile(nTN,aid,tn_id,cl)\n                    if r is None: logs.append(u'[WARN P3] perfil TN '+nm+u': '+e)\n                if nSE not in existing:\n                    r,e=make_profile(nSE,aid,sello_id,cl)\n                    if r is None: logs.append(u'[WARN P3] perfil SELLO '+nm+u': '+e)\n                px=mxx+150.0; py=mny-k*250.0\n                pid,e=make_pv(u'PV-'+nm,aid,px,py,pvs)\n                if pid is None:\n                    logs.append(u'[WARN P3] vista '+nm+u': '+e); continue\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as tr:\n                        pv=tr.GetObject(pid,OpenMode.ForWrite)\n                        try: pv.Name=u'PV-'+nm\n                        except: pass\n                        if pvs!=ObjectId.Null:\n                            try: pv.StyleId=pvs\n                            except: pass\n                        tr.Commit()\n                pv_ids.append(pid)\n            except Exception as e:\n                logs.append(u'[WARN P3] '+str(e))\n        logs.append(u'[OK P3] Vistas de perfil creadas: '+str(len(pv_ids)))\n        OUT=[pv_ids,logs]\nexcept Exception as ex:\n    OUT=[[],logs+[u'[ERROR P3] '+str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1aa36779-62a1-436f-b8e6-a72f47c3ec80",
          "Name": "IN[0]",
          "Description": "Input #0",
