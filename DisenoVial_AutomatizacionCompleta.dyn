          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        }
      ],
      "Replication": "Disabled",
      "Description": "Corredor: alineamiento + rasante existente + assembly camino.",
      "Name": "PASO 4: Crear Corredor",
      "X": 520,
      "Y": 880,
      "Script": "# PASO 4: Corredor vial\n# CORRECCION EXPERTA: NO existe Corridor.Create con todos los argumentos.\n# Patron real: Corridor.Create(CivilDoc, name) -> Baselines.Add(name, aliId,\n# profId) -> BaselineRegions.Add(name, assemblyId) -> Rebuild().\n# La rasante NO se genera: se busca por nombre en el alineamiento.\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Corridor\n\nalignment_id  = IN[0]\nprofile_name  = IN[1]\nassembly_name = IN[2]\nsello_id      = IN[3]\n# IN[4] = pv_id (solo crea dependencia de orden con PASO 3)\n\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col:\n        return s\n    return ObjectId.Null\n\ndef find_profile(ali_id, name):\n    with db.TransactionManager.StartTransaction() as tr:\n        ali = tr.GetObject(ali_id, OpenMode.ForRead)\n        found, names = None, []\n        for pid in ali.GetProfileIds():\n            p = tr.GetObject(pid, OpenMode.ForRead)\n            names.append(p.Name)\n            if p.Name.upper() == name.upper():\n                found = pid\n        tr.Commit()\n    return found, names\n\ndef find_assembly(name):\n    import unicodedata\n    def n(s):\n        return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                       if unicodedata.category(c) != 'Mn').upper()\n    tgt = n(name)\n    with db.TransactionManager.StartTransaction() as tr:\n        for aid in cdoc.GetAssemblyIds():\n            a = tr.GetObject(aid, OpenMode.ForRead)\n            if n(a.Name) == tgt:\n                tr.Commit()\n                return aid\n        tr.Commit()\n    return None\n\ntry:\n    prof_id, avail = find_profile(alignment_id, profile_name)\n    if prof_id is None:\n        raise ValueError(u'Rasante no encontrada: ' + profile_name +\n                         u'. Disponibles: ' + str(avail))\n    asm_id = find_assembly(assembly_name)\n    if asm_id is None:\n        raise ValueError(u'Assembly no encontrado: ' + assembly_name +\n                         u' (verificar en Toolspace > Assemblies).')\n\n    cst = sty(cdoc.Styles.CorridorStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            s0  = ali.StartingStation\n            s1  = ali.EndingStation\n\n            # 1) Crear corredor vacio\n            cor_id = Corridor.Create(cdoc, u'CORREDOR-EJE')\n            cor = tr.GetObject(cor_id, OpenMode.ForWrite)\n            if cst != ObjectId.Null:\n                cor.StyleId = cst\n\n            # 2) Baseline = alineamiento + rasante existente\n            bl  = cor.Baselines.Add(u'BL-EJE', alignment_id, prof_id)\n            # 3) Region = assembly \"camino\" a lo largo de todo el eje\n            reg = bl.BaselineRegions.Add(u'REG-1', asm_id)\n            try:\n                reg.StartStation = s0\n                reg.EndStation   = s1\n            except:\n                pass  # Si falla, C3D usa el rango completo por defecto\n\n            cor.Rebuild()\n            tr.Commit()\n\n    OUT = [cor_id, u'[OK] Corredor CORREDOR-EJE: assembly=' +\n           assembly_name + u', rasante=' + profile_name]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P4] ' + str(ex)]\n"
    },
    {
