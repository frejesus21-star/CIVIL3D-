          "Type2": "var",
          "Index": 1
        }
      ],
      "Replication": "Disabled",
      "Description": "Crea vista de perfil longitudinal con TN y SELLO. A la derecha del alineamiento.",
      "Name": "PASO 3: Crear Vista de Perfil",
      "X": 520,
      "Y": 600,
      "Script": "import clr, sys\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\nalignment_id = IN[0]\ntn_id        = IN[1]\nsello_id     = IN[2]\n\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n\ndef ensure_prof(tr, ali_id, surf_id, name):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        p = tr.GetObject(pid, OpenMode.ForRead)\n        try:\n            if p.SurfaceId == surf_id: return pid\n        except: pass\n    ps = sty(cdoc.Styles.ProfileStyles, 'Standard', u'Estandar')\n    ls = sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles, '_No Labels', 'Standard')\n    return Profile.CreateFromSurface(cdoc, ali_id, surf_id, name, ps, ls)\n\ntry:\n    pvs = sty(cdoc.Styles.ProfileViewStyles, 'Standard', u'Estandar')\n    bss = sty(cdoc.Styles.ProfileViewBandSetStyles, 'Standard', u'Estandar', '_No Bands')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            ext = ali.GeometricExtents\n            ins = Point3d(ext.MaxPoint.X + 150.0, ext.MinPoint.Y, 0)\n            ensure_prof(tr, alignment_id, tn_id,    'PERF-TN')\n            ensure_prof(tr, alignment_id, sello_id, 'PERF-SELLO')\n            pv_id = ProfileView.Create(cdoc, alignment_id, ins, 'PV-EJE', pvs, bss)\n            tr.Commit()\n    OUT = [pv_id, u'[OK] Profile view PV-EJE created with TN and SELLO.']\nexcept Exception as ex:\n    OUT = [None, '[ERR P3] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
