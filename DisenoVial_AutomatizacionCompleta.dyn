    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "aa4e4bec-ebaf-4e71-ad50-12259ecf6f7a",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 1: UN alineamiento por CADA polilinea del modelo (sin filtrar)\n# layerId va como ObjectId (la API no acepta string).\n# OUT = [ [alignment_id, ...], [log...] ]\nimport clr, math\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment\n\nlayer_name = IN[0]   # ya no se usa para filtrar; se conserva por compatibilidad\nali_base   = IN[1]\nDEST_LAYER = 'C-ROAD-CNTR'\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef get_layer_id(tr, name):\n    lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n    if lt.Has(name): return lt[name]\n    lt.UpgradeOpen()\n    ltr = LayerTableRecord(); ltr.Name = name\n    lid = lt.Add(ltr); tr.AddNewlyCreatedDBObject(ltr, True)\n    return lid\n\ndef build_manual(t2, pid, name, lid, ast, lst):\n    pl = t2.GetObject(pid, OpenMode.ForRead)\n    aid = Alignment.Create(cdoc, name, ObjectId.Null, lid, ast, lst)\n    ents = t2.GetObject(aid, OpenMode.ForWrite).Entities\n    nv = pl.NumberOfVertices\n    rng = range(nv) if pl.Closed else range(nv - 1)\n    for i in rng:\n        j = (i + 1) % nv\n        p1 = pl.GetPoint3dAt(i); p2 = pl.GetPoint3dAt(j)\n        bv = pl.GetBulgeAt(i)\n        if abs(bv) < 1e-12:\n            ents.AddFixedLine(Point3d(p1.X,p1.Y,0.0), Point3d(p2.X,p2.Y,0.0))\n        else:\n            t = 4.0*math.atan(abs(bv))\n            d = math.sqrt((p2.X-p1.X)**2+(p2.Y-p1.Y)**2)\n            r = d/(2.0*math.sin(t/2.0))\n            mx,my = (p1.X+p2.X)/2.0,(p1.Y+p2.Y)/2.0\n            dm = math.sqrt(max(0.0, r*r-(d/2.0)**2))\n            ca = math.atan2(p2.Y-p1.Y, p2.X-p1.X)\n            cw = bv < 0\n            pp = ca + (math.pi/2.0 if not cw else -math.pi/2.0)\n            c = Point3d(mx+dm*math.cos(pp), my+dm*math.sin(pp), 0.0)\n            ents.AddFixedArc(c, r, math.atan2(p1.Y-c.Y,p1.X-c.X),\n                             math.atan2(p2.Y-c.Y,p2.X-c.X), cw)\n    return aid\n\ntry:\n    plines = []\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if isinstance(obj, (Polyline, Polyline2d, Polyline3d)):\n                    plines.append(oid)\n            tr.Commit()\n    if not plines:\n        raise ValueError(u'No hay ninguna polilinea en el modelo.')\n\n    ast = sty(cdoc.Styles.AlignmentStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    lst = sty(cdoc.Styles.LabelSetStyles.AlignmentLabelSetStyles, 'Standard', '_No Labels')\n\n    aids = []\n    logs = [u'[INFO P1] Polilineas encontradas: ' + str(len(plines))]\n    one = len(plines) == 1\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            lid = get_layer_id(tr, DEST_LAYER)\n            for k, pid in enumerate(plines):\n                name = ali_base if one else (ali_base + u'-%02d' % (k + 1))\n                try:\n                    aid = Alignment.CreateFromPolyline(cdoc, name, ObjectId.Null,\n                              pid, lid, ast, lst, False, True)\n                    aids.append(aid)\n                    logs.append(u'[OK P1] ' + name + u' creado.')\n                except Exception as e:\n                    try:\n                        with db.TransactionManager.StartTransaction() as t2:\n                            lid2 = get_layer_id(t2, DEST_LAYER)\n                            aid = build_manual(t2, pid, name, lid2, ast, lst)\n                            t2.Commit()\n                        aids.append(aid)\n                        logs.append(u'[OK P1] ' + name + u' creado (manual).')\n                    except Exception as e2:\n                        logs.append(u'[WARN P1] ' + name + u' omitido: ' + str(e2))\n            tr.Commit()\n\n    if not aids:\n        raise ValueError(u'Ninguna polilinea pudo convertirse en alineamiento.')\n    logs.append(u'[INFO P1] Alineamientos creados: ' + str(len(aids)))\n    OUT = [aids, logs]\nexcept Exception as ex:\n    OUT = [[], [u'[ERROR P1] ' + str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1134656e-778c-4305-b598-77763fec3480",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3a4b6566-7b75-4628-a9ed-226b95b753e7",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "316f3e53-45ee-45ce-81e5-ee6a42929941",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Alineamiento desde polilinea"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "99ff3ad8-61e2-4439-bf6a-1dcc98e9d5d0",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 2: SELLO = TN - delta\n# IN[0]=tn IN[1]=sello IN[2]=delta IN[3]=salida_P1 [aid,[logs]]\n# OUT = [sello_id, tn_id, logs_acumulados]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name    = IN[0]\nsello_name = IN[1]\ndelta      = float(IN[2])\np1 = IN[3]\nlogs = list(p1[1]) if (p1 and len(p1) > 1 and p1[1]) else []\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef find_surf(name):\n    for sid in cdoc.GetSurfaceIds():\n        with db.TransactionManager.StartTransaction() as tr:\n            s = tr.GetObject(sid, OpenMode.ForRead); tr.Commit()\n            if s.Name.upper() == name.upper(): return sid\n    return None\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ntry:\n    if not p1 or not p1[0]:\n        OUT = [None, None, logs + [u'[SKIP P2] PASO 1 sin alineamiento.']]\n    else:\n        tn_id = find_surf(tn_name)\n        if tn_id is None:\n            raise ValueError(u'Superficie TN no encontrada: ' + tn_name)\n        ex = find_surf(sello_name)\n        if ex is not None:\n            with doc.LockDocument():\n                with db.TransactionManager.StartTransaction() as tr:\n                    tr.GetObject(ex, OpenMode.ForWrite).Erase(); tr.Commit()\n        st = sty(cdoc.Styles.SurfaceStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                tn  = tr.GetObject(tn_id, OpenMode.ForRead)\n                pts = Point3dCollection()\n                for v in tn.Vertices:\n                    L = v.Location\n                    pts.Add(Point3d(L.X, L.Y, L.Z - delta))\n                sid = TinSurface.Create(cdoc, sello_name)\n                srf = tr.GetObject(sid, OpenMode.ForWrite)\n                if st != ObjectId.Null: srf.StyleId = st\n                srf.AddVertices(pts)\n                srf.Rebuild()\n                tr.Commit()\n        logs.append(u'[OK P2] SELLO = TN - %.3f m (%d vert.)' % (delta, pts.Count))\n        OUT = [sid, tn_id, logs]\nexcept Exception as ex:\n    OUT = [None, None, logs + [u'[ERROR P2] ' + str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1e107ec8-2dfd-4069-849c-5e7aa7ec06e5",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "79443d39-8aa8-415d-9693-6ba2fec66dd2",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d1d2973d-d1ee-491e-8cb9-3c77d1c90e07",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "56ca0abe-ed47-4330-a7a2-8612e5dc9ee8",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1a88c82c-3f40-41bd-84d8-e1f9f6b0a0a2",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "SELLO = TN - delta"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "93d37704-1856-4d56-867b-32fcf1bbab16",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 3: una vista de perfil (TN + SELLO) por CADA alineamiento\n# IN[0]=salida_P1 [aids,logs]  IN[1]=salida_P2 [sello,tn,logs]\n# OUT = [ [pv_id,...], logs_acumulados ]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\np1 = IN[0]; p2 = IN[1]\nlogs = list(p2[2]) if (p2 and len(p2) > 2 and p2[2]) else []\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef surf_profile(tr, ali_id, surf_id, name, lay):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        if tr.GetObject(pid, OpenMode.ForRead).Name == name:\n            return pid\n    ps = sty(cdoc.Styles.ProfileStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    ls = sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles, '_No Labels', 'Standard')\n    return Profile.CreateFromSurface(name, ali_id, surf_id, lay, ps, ls)\n\ntry:\n    aids = p1[0] if (p1 and p1[0]) else []\n    if not aids:\n        OUT = [[], logs + [u'[SKIP P3] PASO 1 sin alineamientos.']]\n    elif not p2 or p2[0] is None:\n        OUT = [[], logs + [u'[SKIP P3] PASO 2 sin SELLO.']]\n    else:\n        sello_id = p2[0]; tn_id = p2[1]\n        pvs = sty(cdoc.Styles.ProfileViewStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n        pv_ids = []\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                cl = db.Clayer\n                for k, aid in enumerate(aids):\n                    try:\n                        ali = tr.GetObject(aid, OpenMode.ForRead)\n                        nm  = ali.Name\n                        ext = ali.GeometricExtents\n                        ins = Point3d(ext.MaxPoint.X + 150.0,\n                                      ext.MinPoint.Y - k * 250.0, 0.0)\n                        surf_profile(tr, aid, tn_id,    u'PERF-TN-'+nm,    cl)\n                        surf_profile(tr, aid, sello_id, u'PERF-SELLO-'+nm, cl)\n                        pv = tr.GetObject(ProfileView.Create(aid, ins), OpenMode.ForWrite)\n                        pv.Name = u'PV-' + nm\n                        if pvs != ObjectId.Null: pv.StyleId = pvs\n                        pv_ids.append(pv.ObjectId)\n                    except Exception as e:\n                        logs.append(u'[WARN P3] vista omitida: ' + str(e))\n                tr.Commit()\n        logs.append(u'[OK P3] Vistas de perfil creadas: ' + str(len(pv_ids)))\n        OUT = [pv_ids, logs]\nexcept Exception as ex:\n    OUT = [[], logs + [u'[ERROR P3] ' + str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "1aa36779-62a1-436f-b8e6-a72f47c3ec80",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "32e19903-feac-48fc-b769-1b2f07283445",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "58efe0fb-fe89-476b-9a55-3be66e478976",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Perfil con TN y SELLO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "706a5ba3-a391-4400-9c40-836fc13a185b",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 4: un corredor por CADA alineamiento que tenga rasante\n# IN[0]=salida_P1 IN[1]=rasante IN[2]=assembly IN[3]=salida_P2 IN[4]=salida_P3\n# La rasante se busca por nombre dentro de cada alineamiento (no se genera).\n# OUT = [ [corridor_id,...], logs_acumulados ]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Corridor\n\np1 = IN[0]; profile_name = IN[1]; assembly_name = IN[2]\np2 = IN[3]; p3 = IN[4]\nlogs = list(p3[1]) if (p3 and len(p3) > 1 and p3[1]) else []\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef find_profile(tr, ali_id, name):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        if tr.GetObject(pid, OpenMode.ForRead).Name.upper() == name.upper():\n            return pid\n    return None\n\ndef find_assembly(name):\n    import unicodedata\n    def n(s):\n        return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                       if unicodedata.category(c) != 'Mn').upper()\n    tgt = n(name)\n    with db.TransactionManager.StartTransaction() as tr:\n        for aid in cdoc.GetAssemblyIds():\n            if n(tr.GetObject(aid, OpenMode.ForRead).Name) == tgt:\n                tr.Commit(); return aid\n        tr.Commit()\n    return None\n\ntry:\n    aids = p1[0] if (p1 and p1[0]) else []\n    if not aids:\n        OUT = [[], logs + [u'[SKIP P4] PASO 1 sin alineamientos.']]\n    elif not p3 or not p3[0]:\n        OUT = [[], logs + [u'[SKIP P4] PASO 3 sin vistas de perfil.']]\n    else:\n        asm_id = find_assembly(assembly_name)\n        if asm_id is None:\n            raise ValueError(u'Assembly no encontrado: ' + assembly_name)\n        cst = sty(cdoc.Styles.CorridorStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n        cor_ids = []\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                for aid in aids:\n                    ali = tr.GetObject(aid, OpenMode.ForRead)\n                    nm  = ali.Name\n                    pr  = find_profile(tr, aid, profile_name)\n                    if pr is None:\n                        logs.append(u'[WARN P4] ' + nm +\n                                    u': sin rasante \"' + profile_name + u'\", omitido.')\n                        continue\n                    s0, s1 = ali.StartingStation, ali.EndingStation\n                    cor = tr.GetObject(Corridor.Create(cdoc, u'COR-'+nm), OpenMode.ForWrite)\n                    if cst != ObjectId.Null: cor.StyleId = cst\n                    bl  = cor.Baselines.Add(u'BL-'+nm, aid, pr)\n                    reg = bl.BaselineRegions.Add(u'REG-1', asm_id)\n                    try:\n                        reg.StartStation = s0; reg.EndStation = s1\n                    except: pass\n                    cor.Rebuild()\n                    cor_ids.append(cor.ObjectId)\n                    logs.append(u'[OK P4] Corredor COR-' + nm + u' creado.')\n                tr.Commit()\n        logs.append(u'[INFO P4] Corredores creados: ' + str(len(cor_ids)) +\n                    u' de ' + str(len(aids)) + u' alineamientos.')\n        OUT = [cor_ids, logs]\nexcept Exception as ex:\n    OUT = [[], logs + [u'[ERROR P4] ' + str(ex)]]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
