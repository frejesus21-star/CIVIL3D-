      ],
      "Replication": "Disabled",
      "Description": "Compensación de tierras + acuerdos KV=800",
      "Name": "PASO 6: Compensar Tierras KV=800",
      "Code": "# PASO 6: Compensar tierras (geometría exacta con taludes)\n# IN[0] alignment_ids   IN[1] profile_name    IN[2] surface_name\n# IN[3] platforms_json  IN[4] kv              IN[5] road_half_width\n# IN[6] cross_slope_road_pct   IN[7] cross_slope_plt_pct\n# IN[8] section_spacing  IN[9] cut_slope_hv   IN[10] fill_slope_hv\nimport clr, sys, json, os\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\n\n_dir = os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else ''\nfor _p in [_dir, os.path.join(_dir,'..'), r'C:\\Civil3D', r'C:\\Users\\Public\\Civil3D']:\n    if _p and _p not in sys.path: sys.path.insert(0, _p)\n\ntry:\n    from platforms import (Platform, compensate_earthwork_all,\n                           resolve_surface_id, resolve_profile_id,\n                           list_profile_names, KV_DEFAULT)\nexcept ImportError as ie:\n    OUT = [[], [\"ERROR: platforms.py no encontrado: %s\" % ie]]; raise SystemExit(0)\n\nlogs = []\nalignment_ids   = IN[0] if isinstance(IN[0], list) else [IN[0]]\nprofile_name    = str(IN[1]).strip()\nsurface_name    = str(IN[2]).strip()\nplatform_json   = str(IN[3]).strip()\nkv              = float(IN[4])  if IN[4]  is not None else KV_DEFAULT\nroad_hw         = float(IN[5])  if IN[5]  is not None else 4.0\ncross_sl_road   = float(IN[6])  if IN[6]  is not None else 2.5\ncross_sl_plt    = float(IN[7])  if IN[7]  is not None else 2.5\nspacing         = float(IN[8])  if IN[8]  is not None else 5.0\ncut_hv          = float(IN[9])  if IN[9]  is not None else 1.0\nfill_hv         = float(IN[10]) if IN[10] is not None else 1.5\n\ntry:\n    surface_id = resolve_surface_id(surface_name)\n    logs.append(\"Superficie '%s' OK.\" % surface_name)\nexcept ValueError as ex:\n    OUT = [[], [str(ex)]]; raise SystemExit(0)\n\ntry:\n    defs = json.loads(platform_json)\nexcept Exception as ex:\n    OUT = [[], [\"ERROR JSON: %s\" % ex]]; raise SystemExit(0)\n\nplatforms = []\nfor item in defs:\n    try:\n        p = Platform(\n            name             = item['name'],\n            pk_start         = float(item['pk_start']),\n            pk_end           = float(item['pk_end']),\n            width            = float(item['width']),\n            side             = item.get('side', 'right'),\n            slope_pct        = float(item.get('slope_pct', 2.0)),\n            elevation_offset = item.get('elevation_offset', None),\n            cut_hv           = float(item.get('cut_hv',  cut_hv)),\n            fill_hv          = float(item.get('fill_hv', fill_hv)),\n        )\n        platforms.append(p)\n        logs.append(\"OK: %s\" % p)\n    except Exception as ex:\n        logs.append(\"ERROR '%s': %s\" % (item.get('name','?'), ex))\n\nif not platforms:\n    OUT = [[], logs + [\"Sin plataformas validas.\"]]; raise SystemExit(0)\n\nfor ali_id in alignment_ids:\n    profile_id = resolve_profile_id(ali_id, profile_name)\n    if profile_id is None:\n        logs.append(\"AVISO: rasante '%s' no encontrada. Disponibles: %s\"\n                    % (profile_name, list_profile_names(ali_id)))\n        OUT = [[], logs]; raise SystemExit(0)\n\n    results = compensate_earthwork_all(\n        surface_id, ali_id, profile_id, platforms,\n        kv=kv, road_half_width=road_hw,\n        cross_slope_road_pct=cross_sl_road,\n        cross_slope_plt_pct=cross_sl_plt,\n        spacing=spacing, search_range=5.0,\n    )\n    for r in results:\n        logs.append(\n            \"[%(name)s] Dz=%(elevation_offset)+.3fm  \"\n            \"Corte=%(volume_cut).1f m3  Relleno=%(volume_fill).1f m3  \"\n            \"Balance=%(balance_m3)+.1f m3  \"\n            \"L_ent=%(L_entry).1f m  L_sal=%(L_exit).1f m\" % r\n        )\n        for w in r.get('warnings',[]): logs.append(\"  AVISO: \" + w)\n        for e in r.get('errors',  []): logs.append(\"  ERROR: \" + e)\n\nOUT = [platforms, logs]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "dd65cf68-127f-4a38-9673-2b2166cd7459",
      "Inputs": [
        {
          "Id": "f0f6eb2e-cd02-4bb2-9fa1-d4911781dfea",
          "Name": "IN[0]",
          "Description": "platforms"
