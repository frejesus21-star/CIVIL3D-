    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "NodeType": "NumberInputNode",
      "Id": "cee82eb7-79d2-4f25-81f7-d2af0ed8d920",
      "Name": "Bombeo plataforma (%)",
