        },
        {
          "Id": "20e533b6-b202-4ce9-bc71-87b8c9128961",
          "Name": "OUT[1]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d8813339-76ce-43c0-91c5-5f937cfd1b53",
          "Name": "OUT[2]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "SELLO = TN - delta"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "3cc312b2-3807-42bc-ab5a-db3174b83e69",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 3: Vista de perfil longitudinal con TN y SELLO\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\nalignment_id = IN[0]\ntn_id        = IN[1]\nsello_id     = IN[2]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef surf_profile(tr, ali_id, surf_id, name, layer_oid):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        if tr.GetObject(pid, OpenMode.ForRead).Name == name:\n            return pid\n    ps = sty(cdoc.Styles.ProfileStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    ls = sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles, '_No Labels', 'Standard')\n    return Profile.CreateFromSurface(name, ali_id, surf_id, layer_oid, ps, ls)\n\ntry:\n    pvs = sty(cdoc.Styles.ProfileViewStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            ext = ali.GeometricExtents\n            ins = Point3d(ext.MaxPoint.X + 150.0, ext.MinPoint.Y, 0.0)\n            cl  = db.Clayer\n            surf_profile(tr, alignment_id, tn_id,    u'PERF-TN',    cl)\n            surf_profile(tr, alignment_id, sello_id, u'PERF-SELLO', cl)\n            pv_id = ProfileView.Create(alignment_id, ins)\n            pv = tr.GetObject(pv_id, OpenMode.ForWrite)\n            pv.Name = u'PV-EJE'\n            if pvs != ObjectId.Null:\n                pv.StyleId = pvs\n            tr.Commit()\n    OUT = [pv_id, u'[OK] Vista de perfil PV-EJE con TN y SELLO.']\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P3] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "d561d460-e2be-44af-b7bf-16e4db7412ab",
