    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "57972e30-79d1-47d7-af48-b2f9b066902f",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 1: Alineamiento desde polilinea en capa \"EJE DE CAMINO\"\n# Requiere paquete DynamoIronPython2.7 en Civil 3D 2026\nimport clr, math\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment\n\nlayer_name = IN[0]\nali_name   = IN[1]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef norm(s):\n    import unicodedata\n    return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                   if unicodedata.category(c) != 'Mn').upper()\n\ndef bulge_arc(p1, p2, b):\n    t  = 4.0 * math.atan(abs(b))\n    d  = math.sqrt((p2.X-p1.X)**2 + (p2.Y-p1.Y)**2)\n    if d < 1e-9: return None\n    r  = d / (2.0 * math.sin(t / 2.0))\n    mx, my = (p1.X+p2.X)/2.0, (p1.Y+p2.Y)/2.0\n    dm = math.sqrt(max(0.0, r*r - (d/2.0)**2))\n    ca = math.atan2(p2.Y-p1.Y, p2.X-p1.X)\n    cw = b < 0\n    pp = ca + (math.pi/2.0 if not cw else -math.pi/2.0)\n    return {'c': Point3d(mx+dm*math.cos(pp), my+dm*math.sin(pp), 0.0), 'r': r,\n            'sa': 0.0, 'ea': 0.0, 'cw': cw,\n            'p1': p1, 'p2': p2}\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ntry:\n    tgt = norm(layer_name)\n    pid = None\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if norm(obj.Layer) == tgt and isinstance(obj, (Polyline, Polyline2d, Polyline3d)):\n                    pid = oid\n                    break\n            tr.Commit()\n    if pid is None:\n        raise ValueError(u'No se encontro polilinea en la capa: ' + layer_name)\n\n    ast = sty(cdoc.Styles.AlignmentStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    lst = sty(cdoc.Styles.LabelSetStyles.AlignmentLabelSetStyles, 'Standard', '_No Labels')\n\n    aid, log = None, ''\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            try:\n                aid = Alignment.CreateFromPolyline(\n                    cdoc, ali_name, ObjectId.Null, pid,\n                    'C-ROAD-CNTR', ast, lst, False, True)\n                log = u'[OK] Alineamiento creado (arcos preservados).'\n                tr.Commit()\n            except Exception as e:\n                tr.Abort()\n                log = u'[WARN] CreateFromPolyline fallo: ' + str(e) + u' -> fallback manual.'\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as t2:\n                        pl = t2.GetObject(pid, OpenMode.ForRead)\n                        aid = Alignment.Create(cdoc, ali_name, ObjectId.Null,\n                                               'C-ROAD-CNTR', ast, lst)\n                        ents = t2.GetObject(aid, OpenMode.ForWrite).Entities\n                        nv = pl.NumberOfVertices\n                        rng = range(nv) if pl.Closed else range(nv - 1)\n                        for i in rng:\n                            j  = (i + 1) % nv\n                            p1 = pl.GetPoint3dAt(i)\n                            p2 = pl.GetPoint3dAt(j)\n                            bv = pl.GetBulgeAt(i)\n                            if abs(bv) < 1e-12:\n                                ents.AddFixedLine(Point3d(p1.X,p1.Y,0.0),\n                                                  Point3d(p2.X,p2.Y,0.0))\n                            else:\n                                a = bulge_arc(p1, p2, bv)\n                                c = a['c']\n                                sa = math.atan2(p1.Y-c.Y, p1.X-c.X)\n                                ea = math.atan2(p2.Y-c.Y, p2.X-c.X)\n                                ents.AddFixedArc(c, a['r'], sa, ea, a['cw'])\n                        t2.Commit()\n                        log += u' Alineamiento manual OK.'\n    OUT = [aid, log]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P1] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "0d8f1118-ef3d-4ed2-b93f-ab528f16c93e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2b61017a-11d6-4620-b583-91a0657f1d5f",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8feb60f2-fd6e-4535-a807-b90fdddac984",
          "Name": "OUT[0]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dfd3e396-b51a-497b-9c9b-4a0d026a6ab7",
          "Name": "OUT[1]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Alineamiento desde polilinea EJE DE CAMINO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "e49d2208-542b-42d5-86e4-93155a140f9b",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 2: SELLO = TN - delta (vertices TIN con offset Z)\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name    = IN[0]\nsello_name = IN[1]\ndelta      = float(IN[2])\n# IN[3] = alignment_id (dependencia de orden)\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef find_surf(name):\n    for sid in cdoc.GetSurfaceIds():\n        with db.TransactionManager.StartTransaction() as tr:\n            s = tr.GetObject(sid, OpenMode.ForRead)\n            tr.Commit()\n            if s.Name.upper() == name.upper():\n                return sid\n    return None\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ntry:\n    tn_id = find_surf(tn_name)\n    if tn_id is None:\n        raise ValueError(u'Superficie TN no encontrada: ' + tn_name)\n    ex = find_surf(sello_name)\n    if ex is not None:\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                tr.GetObject(ex, OpenMode.ForWrite).Erase()\n                tr.Commit()\n    st = sty(cdoc.Styles.SurfaceStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            tn  = tr.GetObject(tn_id, OpenMode.ForRead)\n            pts = Point3dCollection()\n            for v in tn.Vertices:\n                L = v.Location\n                pts.Add(Point3d(L.X, L.Y, L.Z - delta))\n            sid = TinSurface.Create(cdoc, sello_name)\n            srf = tr.GetObject(sid, OpenMode.ForWrite)\n            if st != ObjectId.Null:\n                srf.StyleId = st\n            srf.AddVertices(pts)\n            srf.Rebuild()\n            tr.Commit()\n    OUT = [sid, tn_id, u'[OK] SELLO = TN - %.3f m. Vertices: %d' % (delta, pts.Count)]\nexcept Exception as ex:\n    OUT = [None, None, u'[ERROR P2] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "af30b8ea-b244-45c3-b846-2c843ccab918",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3fdfff63-6632-4e25-8d84-b415d3e4ff96",
          "Name": "IN[1]",
          "Description": "Input #1",
