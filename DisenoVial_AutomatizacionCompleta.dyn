      ],
      "Outputs": [
        {
          "Id": "7a10afeb-6fa2-4512-8036-4ce738a09925",
          "Name": "OUT",
          "Description": ""
        }
      ],
      "Replication": "Disabled",
      "Description": "PIPs rasante + regiones corredor + feature lines + TIN plataforma",
      "Name": "PASO 7: Integrar Plataformas al Corredor",
      "Code": "# PASO 7: Integrar Plataformas al Corredor (FL + TIN + PIPs + Regiones)\n# IN[0] platforms          IN[1] corridor_ids      IN[2] alignment_ids\n# IN[3] profile_name       IN[4] asm_plataforma    IN[5] surface_name\n# IN[6] kv                 IN[7] road_half_width   IN[8] cross_slope_road_pct\n# IN[9] cross_slope_plt_pct   IN[10] section_spacing\n# IN[11] layer_borde       IN[12] layer_talud      IN[13] surface_prefix\nimport clr, sys, os\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\n\n_dir = os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else ''\nfor _p in [_dir, os.path.join(_dir,'..'), r'C:\\Civil3D', r'C:\\Users\\Public\\Civil3D']:\n    if _p and _p not in sys.path: sys.path.insert(0, _p)\n\ntry:\n    from platforms import (\n        add_platform_pips_to_profile, add_platform_regions_to_corridor,\n        create_platform_feature_lines, create_platform_tin_surface,\n        resolve_surface_id, resolve_profile_id, list_profile_names,\n        KV_DEFAULT, LAYER_BORDE, LAYER_TALUD,\n    )\nexcept ImportError as ie:\n    OUT = [[], [\"ERROR: platforms.py no encontrado: %s\" % ie]]; raise SystemExit(0)\n\nlogs          = []\nplatforms     = IN[0]  if isinstance(IN[0], list) else [IN[0]]\ncorridor_ids  = IN[1]  if isinstance(IN[1], list) else [IN[1]]\nalignment_ids = IN[2]  if isinstance(IN[2], list) else [IN[2]]\nprofile_name  = str(IN[3]).strip()\nasm_name      = str(IN[4]).strip()\nsurface_name  = str(IN[5]).strip()\nkv            = float(IN[6])  if IN[6]  is not None else KV_DEFAULT\nroad_hw       = float(IN[7])  if IN[7]  is not None else 4.0\ncross_sl_road = float(IN[8])  if IN[8]  is not None else 2.5\ncross_sl_plt  = float(IN[9])  if IN[9]  is not None else 2.5\nspacing       = float(IN[10]) if IN[10] is not None else 5.0\nlayer_borde   = str(IN[11]).strip() if IN[11] is not None else LAYER_BORDE\nlayer_talud   = str(IN[12]).strip() if IN[12] is not None else LAYER_TALUD\nsurf_pfx      = str(IN[13]).strip() if IN[13] is not None else \"PLT\"\n\ntry:\n    surface_id = resolve_surface_id(surface_name)\nexcept ValueError as ex:\n    OUT = [[], [str(ex)]]; raise SystemExit(0)\n\nfor ali_id, cor_id in zip(alignment_ids, corridor_ids):\n    profile_id = resolve_profile_id(ali_id, profile_name)\n    if profile_id is None:\n        logs.append(\"AVISO: rasante '%s' no encontrada. Disponibles: %s\"\n                    % (profile_name, list_profile_names(ali_id)))\n        continue\n\n    logs += add_platform_pips_to_profile(ali_id, profile_id, platforms, kv)\n    logs += add_platform_regions_to_corridor(cor_id, ali_id, asm_name, platforms)\n    logs += create_platform_feature_lines(\n        surface_id, ali_id, profile_id, platforms,\n        road_half_width=road_hw,\n        cross_slope_road_pct=cross_sl_road,\n        cross_slope_plt_pct=cross_sl_plt,\n        layer_borde=layer_borde, layer_talud=layer_talud,\n        spacing=spacing,\n    )\n    logs += create_platform_tin_surface(\n        ali_id, profile_id, platforms,\n        surface_name_prefix=surf_pfx,\n        road_half_width=road_hw,\n        cross_slope_road_pct=cross_sl_road,\n        cross_slope_plt_pct=cross_sl_plt,\n        spacing=spacing,\n    )\n\nlogs.append(\"PASO 7 completado.\")\nOUT = [platforms, logs]\n"
    },
    {
