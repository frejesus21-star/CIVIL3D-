      ],
      "Replication": "Disabled",
      "Description": "Crea alineamiento desde polilinea en EJE DE CAMINO. Geometria mixta (lineas+arcos).",
      "Name": "PASO 1: Crear Alineamiento",
      "X": 520,
      "Y": 0,
      "Script": "import clr, sys, math\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment\n\nlayer_name = IN[0]\nali_name   = IN[1]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef norm(s):\n    import unicodedata\n    return ''.join(c for c in unicodedata.normalize('NFD', unicode(s)) if unicodedata.category(c) != 'Mn').upper()\n\ndef bulge_arc(p1, p2, b):\n    t  = 4.0 * math.atan(abs(b))\n    d  = math.sqrt((p2.X-p1.X)**2 + (p2.Y-p1.Y)**2)\n    if d < 1e-9: return None\n    r  = d / (2.0 * math.sin(t / 2.0))\n    mx, my = (p1.X+p2.X)/2.0, (p1.Y+p2.Y)/2.0\n    dm = math.sqrt(max(0, r**2 - (d/2.0)**2))\n    ca = math.atan2(p2.Y-p1.Y, p2.X-p1.X)\n    cw = b < 0\n    pp = ca + (math.pi/2.0 if not cw else -math.pi/2.0)\n    cx = mx + dm*math.cos(pp)\n    cy = my + dm*math.sin(pp)\n    return {'c':Point3d(cx,cy,0),'r':r,'sa':math.atan2(p1.Y-cy,p1.X-cx),'ea':math.atan2(p2.Y-cy,p2.X-cx),'cw':cw}\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n\ntry:\n    tgt = norm(layer_name)\n    pid = None\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if norm(obj.Layer) == tgt and isinstance(obj, (Polyline, Polyline2d, Polyline3d)):\n                    pid = oid\n                    break\n            tr.Commit()\n    if pid is None:\n        raise ValueError(u'Polyline not found in layer: ' + layer_name)\n    ast = sty(cdoc.Styles.AlignmentStyles, 'Standard', u'Estandar')\n    lst = sty(cdoc.Styles.LabelSetStyles.AlignmentLabelSetStyles, 'Standard', '_No Labels')\n    aid = None\n    log = ''\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            try:\n                aid = Alignment.CreateFromPolyline(cdoc, ali_name, ObjectId.Null, pid, 'C-ROAD-CNTR', ast, lst, False, True)\n                log = u'[OK] Alignment created.'\n                tr.Commit()\n            except Exception as e:\n                tr.Abort()\n                log = u'[WARN] Fallback: ' + str(e)\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as t2:\n                        pl  = t2.GetObject(pid, OpenMode.ForRead)\n                        aid = Alignment.Create(cdoc, ali_name, ObjectId.Null, 'C-ROAD-CNTR', ast, lst)\n                        al  = t2.GetObject(aid, OpenMode.ForWrite)\n                        for i in range(pl.NumberOfVertices - 1):\n                            p1 = pl.GetPoint3dAt(i)\n                            p2 = pl.GetPoint3dAt(i+1)\n                            bv = pl.GetBulgeAt(i)\n                            if bv == 0.0:\n                                al.Entities.AddFixedLine(Point3d(p1.X,p1.Y,0), Point3d(p2.X,p2.Y,0))\n                            else:\n                                av = bulge_arc(p1, p2, bv)\n                                if av:\n                                    al.Entities.AddFixedArc(av['c'], av['r'], av['sa'], av['ea'], av['cw'])\n                        t2.Commit()\n                        log += ' Done.'\n    OUT = [aid, log]\nexcept Exception as ex:\n    OUT = [None, '[ERR P1] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000002-0000-0000-0000-000000000000",
