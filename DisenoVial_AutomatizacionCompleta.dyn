          "KeepListStructure": false
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-i3",
          "Name": "alignment_id",
          "Description": "Dependencia PASO 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o0",
          "Name": "sello_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 0
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o1",
          "Name": "tn_id",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 1
        },
        {
          "Id": "e0000002-0000-0000-0000-000000000000-o2",
          "Name": "log",
          "Description": "",
          "Type": "var",
          "Type2": "var",
          "Index": 2
        }
      ],
      "Replication": "Disabled",
      "Description": "Crea SELLO = TN - delta. Delta ajustable (0.00-0.60 m).",
      "Name": "PASO 2: Crear Superficie SELLO",
      "X": 520,
      "Y": 300,
      "Script": "import clr, sys\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name    = IN[0]\nsello_name = IN[1]\ndelta      = float(IN[2])\n# IN[3] = alignment_id — forza orden de ejecucion\n\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef find_surf(name):\n    for sid in cdoc.GetSurfaceIds():\n        with db.TransactionManager.StartTransaction() as tr:\n            s = tr.GetObject(sid, OpenMode.ForRead)\n            tr.Commit()\n            if s.Name.upper() == name.upper(): return sid\n    return None\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n\ntry:\n    tn_id = find_surf(tn_name)\n    if tn_id is None:\n        raise ValueError(u'Surface not found: ' + tn_name)\n    ex_id = find_surf(sello_name)\n    if ex_id is not None:\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                s = tr.GetObject(ex_id, OpenMode.ForWrite)\n                s.Erase()\n                tr.Commit()\n    st = sty(cdoc.Styles.SurfaceStyles, 'Standard', u'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            sid  = TinSurface.Create(cdoc, sello_name)\n            srf  = tr.GetObject(sid, OpenMode.ForWrite)\n            srf.StyleId = st\n            try:\n                srf.DefinitionAddPastedSurface(tn_id)\n                srf.ElevationAdjustment = -delta\n                srf.Rebuild()\n                mth = 'Pasted'\n            except AttributeError:\n                tn = tr.GetObject(tn_id, OpenMode.ForRead)\n                for pt in tn.GetPoints():\n                    srf.AddPoint(Point3d(pt.X, pt.Y, pt.Z - delta))\n                srf.Rebuild()\n                mth = 'Manual'\n            tr.Commit()\n    OUT = [sid, tn_id, u'[OK] SELLO created. Delta=' + str(delta) + 'm. Method=' + mth]\nexcept Exception as ex:\n    OUT = [None, None, '[ERR P2] ' + str(ex)]\n"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "VariableInputPorts": false,
      "Id": "e0000003-0000-0000-0000-000000000000",
      "Inputs": [
