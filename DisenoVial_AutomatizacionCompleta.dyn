    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "42a9e8c0-14dd-4299-a479-e2fceb2d2a9a",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 1: Alineamiento desde polilinea en capa \"EJE DE CAMINO\"\n# Requiere paquete DynamoIronPython2.7. Salida unica: OUT = [alignment_id, log]\nimport clr, math\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Alignment\n\nlayer_name = IN[0]\nali_name   = IN[1]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef norm(s):\n    import unicodedata\n    return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                   if unicodedata.category(c) != 'Mn').upper()\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ntry:\n    tgt = norm(layer_name)\n    pid = None\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if norm(obj.Layer) == tgt and isinstance(obj, (Polyline, Polyline2d, Polyline3d)):\n                    pid = oid; break\n            tr.Commit()\n    if pid is None:\n        raise ValueError(u'No se encontro polilinea en la capa: ' + layer_name)\n    ast = sty(cdoc.Styles.AlignmentStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    lst = sty(cdoc.Styles.LabelSetStyles.AlignmentLabelSetStyles, 'Standard', '_No Labels')\n    aid, log = None, ''\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            try:\n                aid = Alignment.CreateFromPolyline(cdoc, ali_name, ObjectId.Null,\n                          pid, 'C-ROAD-CNTR', ast, lst, False, True)\n                log = u'[OK] Alineamiento creado (arcos preservados).'\n                tr.Commit()\n            except Exception as e:\n                tr.Abort()\n                log = u'[WARN] CreateFromPolyline fallo: ' + str(e) + u' -> manual.'\n                with doc.LockDocument():\n                    with db.TransactionManager.StartTransaction() as t2:\n                        pl = t2.GetObject(pid, OpenMode.ForRead)\n                        aid = Alignment.Create(cdoc, ali_name, ObjectId.Null,\n                                               'C-ROAD-CNTR', ast, lst)\n                        ents = t2.GetObject(aid, OpenMode.ForWrite).Entities\n                        nv = pl.NumberOfVertices\n                        rng = range(nv) if pl.Closed else range(nv - 1)\n                        for i in rng:\n                            j = (i + 1) % nv\n                            p1 = pl.GetPoint3dAt(i); p2 = pl.GetPoint3dAt(j)\n                            bv = pl.GetBulgeAt(i)\n                            if abs(bv) < 1e-12:\n                                ents.AddFixedLine(Point3d(p1.X,p1.Y,0.0),\n                                                  Point3d(p2.X,p2.Y,0.0))\n                            else:\n                                t = 4.0*math.atan(abs(bv))\n                                d = math.sqrt((p2.X-p1.X)**2+(p2.Y-p1.Y)**2)\n                                r = d/(2.0*math.sin(t/2.0))\n                                mx,my = (p1.X+p2.X)/2.0,(p1.Y+p2.Y)/2.0\n                                dm = math.sqrt(max(0.0, r*r-(d/2.0)**2))\n                                ca = math.atan2(p2.Y-p1.Y, p2.X-p1.X)\n                                cw = bv < 0\n                                pp = ca + (math.pi/2.0 if not cw else -math.pi/2.0)\n                                c = Point3d(mx+dm*math.cos(pp), my+dm*math.sin(pp), 0.0)\n                                sa = math.atan2(p1.Y-c.Y, p1.X-c.X)\n                                ea = math.atan2(p2.Y-c.Y, p2.X-c.X)\n                                ents.AddFixedArc(c, r, sa, ea, cw)\n                        t2.Commit()\n                        log += u' Alineamiento manual OK.'\n    OUT = [aid, log]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P1] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "89ba3854-9bd6-4574-a8ed-5b6ca09792fc",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "778d2cf1-a378-49e5-b0d3-e455135387e0",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5da5bcd1-613d-4e70-a48d-d0b18efff20d",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Alineamiento desde polilinea"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "805aa8bc-9986-4bc4-9ac2-37c3e9cb4291",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 2: SELLO = TN - delta\n# IN[0]=tn_name IN[1]=sello_name IN[2]=delta IN[3]=salida_PASO1 (lista)\n# Salida unica: OUT = [sello_id, tn_id, log]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\ntn_name    = IN[0]\nsello_name = IN[1]\ndelta      = float(IN[2])\np1 = IN[3]  # [alignment_id, log] del PASO 1 (solo fuerza orden)\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef find_surf(name):\n    for sid in cdoc.GetSurfaceIds():\n        with db.TransactionManager.StartTransaction() as tr:\n            s = tr.GetObject(sid, OpenMode.ForRead); tr.Commit()\n            if s.Name.upper() == name.upper(): return sid\n    return None\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ntry:\n    if p1 is None or p1[0] is None:\n        raise ValueError(u'PASO 1 no entrego alineamiento. Revisar PASO 1.')\n    tn_id = find_surf(tn_name)\n    if tn_id is None:\n        raise ValueError(u'Superficie TN no encontrada: ' + tn_name)\n    ex = find_surf(sello_name)\n    if ex is not None:\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                tr.GetObject(ex, OpenMode.ForWrite).Erase(); tr.Commit()\n    st = sty(cdoc.Styles.SurfaceStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            tn  = tr.GetObject(tn_id, OpenMode.ForRead)\n            pts = Point3dCollection()\n            for v in tn.Vertices:\n                L = v.Location\n                pts.Add(Point3d(L.X, L.Y, L.Z - delta))\n            sid = TinSurface.Create(cdoc, sello_name)\n            srf = tr.GetObject(sid, OpenMode.ForWrite)\n            if st != ObjectId.Null: srf.StyleId = st\n            srf.AddVertices(pts)\n            srf.Rebuild()\n            tr.Commit()\n    OUT = [sid, tn_id, u'[OK] SELLO = TN - %.3f m (%d vertices)' % (delta, pts.Count)]\nexcept Exception as ex:\n    OUT = [None, None, u'[ERROR P2] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "2b8ed556-5d1f-49a3-ab51-16404a7a346f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c4a7f508-3b84-4a07-b0c0-2d21b1441f4f",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8e719d1c-1c18-45b5-8357-7b44e4a1a9ee",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "eadeebc3-b6f3-4793-83f8-88a8f0f99808",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6cb9cc6a-db7d-49be-8b05-5b265e9d51d7",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "SELLO = TN - delta"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "1676c159-27f1-459d-a5bf-d496b92019fe",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 3: Vista de perfil con TN y SELLO\n# IN[0]=salida_PASO1 IN[1]=salida_PASO2 ; OUT = [profile_view_id, log]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile, ProfileView\n\np1 = IN[0]   # [alignment_id, log]\np2 = IN[1]   # [sello_id, tn_id, log]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef surf_profile(tr, ali_id, surf_id, name, layer_oid):\n    ali = tr.GetObject(ali_id, OpenMode.ForRead)\n    for pid in ali.GetProfileIds():\n        if tr.GetObject(pid, OpenMode.ForRead).Name == name:\n            return pid\n    ps = sty(cdoc.Styles.ProfileStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    ls = sty(cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles, '_No Labels', 'Standard')\n    return Profile.CreateFromSurface(name, ali_id, surf_id, layer_oid, ps, ls)\n\ntry:\n    if p1 is None or p1[0] is None:\n        raise ValueError(u'PASO 1 sin alineamiento.')\n    if p2 is None or p2[0] is None:\n        raise ValueError(u'PASO 2 sin superficie SELLO.')\n    alignment_id = p1[0]\n    sello_id     = p2[0]\n    tn_id        = p2[1]\n    pvs = sty(cdoc.Styles.ProfileViewStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            ext = ali.GeometricExtents\n            ins = Point3d(ext.MaxPoint.X + 150.0, ext.MinPoint.Y, 0.0)\n            cl  = db.Clayer\n            surf_profile(tr, alignment_id, tn_id,    u'PERF-TN',    cl)\n            surf_profile(tr, alignment_id, sello_id, u'PERF-SELLO', cl)\n            pv_id = ProfileView.Create(alignment_id, ins)\n            pv = tr.GetObject(pv_id, OpenMode.ForWrite)\n            pv.Name = u'PV-EJE'\n            if pvs != ObjectId.Null: pv.StyleId = pvs\n            tr.Commit()\n    OUT = [pv_id, u'[OK] Vista de perfil PV-EJE con TN y SELLO.']\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P3] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "245a4da0-7b5c-42db-96ac-f3abe9117b5a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9c384b6e-1606-49ed-ab57-c027f40e2642",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "818c9fe2-c0ee-4fb7-9f57-17b9e8e64c8b",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Perfil con TN y SELLO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "1c5116ca-7778-4cd8-9e8e-b8d62c4fe198",
      "NodeType": "PythonScriptNode",
      "Code": "# PASO 4: Corredor con rasante existente y assembly \"camino\"\n# IN[0]=salida_PASO1 IN[1]=profile_name IN[2]=assembly_name\n# IN[3]=salida_PASO2 IN[4]=salida_PASO3 ; OUT = [corridor_id, log]\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Corridor\n\np1 = IN[0]\nprofile_name  = IN[1]\nassembly_name = IN[2]\np2 = IN[3]\np3 = IN[4]\ndoc  = Application.DocumentManager.MdiActiveDocument\ndb   = doc.Database\ncdoc = CivilApplication.ActiveDocument\n\ndef sty(col, *ns):\n    for n in ns:\n        try: return col[n]\n        except: pass\n    for s in col: return s\n    return ObjectId.Null\n\ndef find_profile(ali_id, name):\n    with db.TransactionManager.StartTransaction() as tr:\n        ali = tr.GetObject(ali_id, OpenMode.ForRead)\n        found, names = None, []\n        for pid in ali.GetProfileIds():\n            p = tr.GetObject(pid, OpenMode.ForRead)\n            names.append(p.Name)\n            if p.Name.upper() == name.upper(): found = pid\n        tr.Commit()\n    return found, names\n\ndef find_assembly(name):\n    import unicodedata\n    def n(s):\n        return ''.join(c for c in unicodedata.normalize('NFD', unicode(s))\n                       if unicodedata.category(c) != 'Mn').upper()\n    tgt = n(name)\n    with db.TransactionManager.StartTransaction() as tr:\n        for aid in cdoc.GetAssemblyIds():\n            if n(tr.GetObject(aid, OpenMode.ForRead).Name) == tgt:\n                tr.Commit(); return aid\n        tr.Commit()\n    return None\n\ntry:\n    if p1 is None or p1[0] is None:\n        raise ValueError(u'PASO 1 sin alineamiento.')\n    if p3 is None or p3[0] is None:\n        raise ValueError(u'PASO 3 sin vista de perfil.')\n    alignment_id = p1[0]\n    prof_id, avail = find_profile(alignment_id, profile_name)\n    if prof_id is None:\n        raise ValueError(u'Rasante no encontrada: ' + profile_name +\n                         u'. Disponibles: ' + str(avail))\n    asm_id = find_assembly(assembly_name)\n    if asm_id is None:\n        raise ValueError(u'Assembly no encontrado: ' + assembly_name)\n    cst = sty(cdoc.Styles.CorridorStyles, 'Standard', u'Est\\xe1ndar', 'Estandar')\n    with doc.LockDocument():\n        with db.TransactionManager.StartTransaction() as tr:\n            ali = tr.GetObject(alignment_id, OpenMode.ForRead)\n            s0, s1 = ali.StartingStation, ali.EndingStation\n            cor_id = Corridor.Create(cdoc, u'CORREDOR-EJE')\n            cor = tr.GetObject(cor_id, OpenMode.ForWrite)\n            if cst != ObjectId.Null: cor.StyleId = cst\n            bl  = cor.Baselines.Add(u'BL-EJE', alignment_id, prof_id)\n            reg = bl.BaselineRegions.Add(u'REG-1', asm_id)\n            try:\n                reg.StartStation = s0\n                reg.EndStation   = s1\n            except: pass\n            cor.Rebuild()\n            tr.Commit()\n    OUT = [cor_id, u'[OK] Corredor: assembly=' + assembly_name +\n           u', rasante=' + profile_name]\nexcept Exception as ex:\n    OUT = [None, u'[ERROR P4] ' + str(ex)]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "289b5321-2398-4037-a60f-4e5644f2150a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
