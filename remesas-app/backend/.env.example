PORT=4000
JWT_SECRET=cambia_esto_por_un_secreto_seguro
NODE_ENV=development

# Tasas de respaldo (se usan solo si las APIs externas de tasas no responden)
# Un admin debe mantenerlas actualizadas, sobre todo la de VES por la inflación.
FALLBACK_USD_CLP=950
FALLBACK_USD_VES=45

# Secreto para promover el primer usuario a admin (via POST /api/admin/seed)
ADMIN_SEED_SECRET=cambia_este_secreto_admin

# Envío de emails. Si no defines SMTP_HOST, los correos se simulan en consola
# (modo desarrollo). Define estas variables para enviar de verdad en producción.
# APP_URL=https://tu-dominio.app
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# SMTP_FROM=RemesasVE <no-reply@tu-dominio.app>
