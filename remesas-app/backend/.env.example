PORT=4000
JWT_SECRET=cambia_esto_por_un_secreto_seguro
NODE_ENV=development

# Tasas de respaldo (se usan solo si las APIs externas de tasas no responden)
# Un admin debe mantenerlas actualizadas, sobre todo la de VES por la inflación.
FALLBACK_USD_CLP=950
FALLBACK_USD_VES=45

# Secreto para promover el primer usuario a admin (via POST /api/admin/seed)
ADMIN_SEED_SECRET=cambia_este_secreto_admin

# Base de datos. Por defecto usa SQLite (archivo local, ideal para desarrollo).
# Para producción/escala se recomienda PostgreSQL: levanta el servicio con
# docker compose up -d y migra los datos con scripts/migrate-to-postgres.js
# DATABASE_URL=postgres://remesas:remesas@localhost:5432/remesas

# ─── Envío de emails ─────────────────────────────────────────────────────────
# Si NO defines SMTP_HOST, los correos se "simulan" en consola (modo desarrollo).
# Para enviar de verdad, descomenta y completa según tu proveedor.
# Guía paso a paso en README → "Conectar un proveedor de email real".
#
# APP_URL=https://tu-dominio.app          # usado en los enlaces de los correos
# SMTP_FROM=RemesasVE <no-reply@tu-dominio.app>   # debe ser un remitente verificado

# Opción A — SendGrid (el usuario SIEMPRE es la palabra literal "apikey")
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx     # tu API Key de SendGrid

# Opción B — Amazon SES (credenciales SMTP, NO las claves de acceso de AWS)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com   # ajusta la región
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=AKIA...                        # usuario SMTP de SES
# SMTP_PASS=...                            # contraseña SMTP de SES

# Opción C — cualquier SMTP genérico (Mailgun, Postmark, Gmail, etc.)
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false                        # true si usas el puerto 465
# SMTP_USER=usuario
# SMTP_PASS=contraseña
