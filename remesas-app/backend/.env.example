# ── Obligatorias ──────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_chars
ADMIN_SEED_SECRET=otro_secreto_para_crear_el_primer_admin

# ── Base de datos ──────────────────────────────────────────────────────────────
# Railway inyecta DATABASE_URL automáticamente al añadir el plugin PostgreSQL.
# Si no defines DATABASE_URL, la app usa SQLite (archivo local, solo para dev).
# DATABASE_URL=postgresql://user:pass@host:5432/remesas

# ── URL pública de la app (para los enlaces en los emails) ────────────────────
APP_URL=https://tu-app.railway.app

# ── Tasas de respaldo (si las APIs externas fallan) ───────────────────────────
FALLBACK_USD_CLP=950
FALLBACK_USD_VES=45

# ── Email (opcional — sin esto los correos se simulan en consola) ─────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=tu_api_key_de_sendgrid
# SMTP_FROM=RemesasVE <no-reply@tudominio.com>
